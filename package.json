{
  "name": "zakulisye",
  "private": true,
  "version": "0.1.0",
  "description": "Закулисье — horror game for the web (Three.js WebGPU + TSL, TypeScript, Rapier, recast-navigation)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke && npm run e2e",
    "shot": "node scripts/shot.mjs",
    "smoke": "node scripts/shot.mjs --prod --browser chromium,webkit --name smoke --out .shots/smoke",
    "optimize-asset": "node scripts/optimize-asset.mjs",
    "asset-view": "node scripts/asset-view.mjs",
    "fetch-model": "NODE_USE_ENV_PROXY=1 node scripts/fetch-model.mjs",
    "fetch-sound": "NODE_USE_ENV_PROXY=1 node scripts/fetch-sound.mjs",
    "blender-test": "blender -b -P scripts/blender/bake.py -- --out .shots/tools/bake-test.glb --size 512 --samples 32",
    "mcp-check": "node scripts/mcp-check.mjs",
    "e2e": "node tests/e2e/touch-reader.mjs && node tests/e2e/audio.mjs webkit && node tests/e2e/feedback.mjs webkit && node tests/e2e/feedback-offline.mjs webkit && node tests/e2e/autotune.mjs webkit && node tests/e2e/webapp.mjs && node tests/e2e/death.mjs webkit && node tests/e2e/knock.mjs webkit",
    "e2e:feedback": "node tests/e2e/feedback.mjs webkit && node tests/e2e/feedback-offline.mjs webkit",
    "feedback": "NODE_USE_ENV_PROXY=1 node scripts/feedback/inbox.mjs",
    "e2e:bench": "node tests/e2e/bench.mjs webkit",
    "e2e:play": "node tests/e2e/playthrough.mjs webkit",
    "e2e:memory": "node tests/e2e/memory.mjs webkit",
    "e2e:stutter": "npm run build && node tests/e2e/stutter.mjs webkit --prod",
    "baseline": "node tests/e2e/baseline.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "@recast-navigation/three": "^0.44.0",
    "lil-gui": "^0.21.0",
    "recast-navigation": "^0.44.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "gltfpack": "^1.3.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@donmccurdy/caporal": {
      "glob": "^14.0.6"
    }
  }
}
