{
  "name": "backrooms",
  "private": true,
  "version": "0.1.0",
  "description": "Backrooms horror game for the web, built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run build && npm run smoke",
    "shot": "node scripts/shot.mjs",
    "audio": "node scripts/audio.mjs",
    "qa": "node scripts/qa.mjs",
    "coop": "node scripts/coop-test.mjs",
    "profile": "node scripts/profile.mjs",
    "libs": "node scripts/libs-check.mjs",
    "optimize-asset": "node scripts/optimize-asset.mjs",
    "asset-view": "node scripts/asset-view.mjs",
    "blender-test": "blender -b -P scripts/blender/bake.py -- --out .shots/tools/bake-test.glb --size 512 --samples 32",
    "fetch-model": "NODE_USE_ENV_PROXY=1 node scripts/fetch-model.mjs",
    "fetch-sound": "NODE_USE_ENV_PROXY=1 node scripts/fetch-sound.mjs",
    "mcp-check": "node scripts/mcp-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@pmndrs/detect-gpu": "^6.0.31",
    "@recast-navigation/three": "^0.44.0",
    "peerjs": "^1.5.4",
    "recast-navigation": "^0.44.0",
    "stats-gl": "^4.2.3",
    "three": "^0.160.0",
    "three-bvh-csg": "0.0.17",
    "three-mesh-bvh": "^0.9.18",
    "tweakpane": "^4.0.5",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "gltfpack": "^1.3.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "vite": "^8.3.8"
  }
}
